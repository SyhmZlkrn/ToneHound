{
  "schema": 1,
  "name": "ToneHound source",
  "include": [
    ".gitignore", ".env.example", "README.md", "requirements-*.txt", "pytest.ini",
    "release/*.json", "scripts/*.py", "scripts/*.ps1", "scripts/tests/*.py",
    "native/CMakeLists.txt", "native/*.ps1", "native/README.md", "native/THIRD_PARTY.md", "native/Source/*.h", "native/Source/*.cpp",
    "engine/tonehound/*.py", "engine/tests/*.py", "engine/tools/*.py", "engine/live/*.py", "engine/live/ui/*",
    "assets/user_di/README.md", "docs/*.md", "docs/stereo_matching_regression.json", "docs/retrieval_evaluation.json"
  ],
  "exclude": ["engine/tools/scratch_*.py"],
  "max_file_bytes": 1048576,
  "note": "Only reviewed text source is exported. No credentials, cache, vendor checkouts, weights, music, user DI, captures or build products."
}
